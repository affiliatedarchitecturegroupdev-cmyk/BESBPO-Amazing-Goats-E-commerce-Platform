# Copy to .env. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://ag:ag@localhost:5432/ag
REDIS_URL=redis://localhost:6379
# Store driver: 'memory' (default, no database) or 'sql' (uses DATABASE_URL).
STORE_DRIVER=memory
# Field-level encryption key for personal data (32 bytes: 64 hex or base64url).
# Required by the SQL stores that hold an encrypted field, such as the MFA secret.
FIELD_ENCRYPTION_KEY=
JWT_ISSUER=http://localhost:8080/realms/ag
JWT_AUDIENCE=ag-platform
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
TRADESAFE_CLIENT_ID=
TRADESAFE_CLIENT_SECRET=
TRADESAFE_WEBHOOK_SECRET=
LULAPAY_API_KEY=
LULAPAY_WEBHOOK_SECRET=
# LulaPay longer terms are a pilot; set to true to register the adapter.
LULAPAY_ENABLED=false
WHATSAPP_TOKEN=
# Email: Resend is used when RESEND_API_KEY is set; the generic EMAIL_API_URL
# transport is the fallback for any other provider. Transactional and marketing
# send from different addresses so a complaint cannot hurt order mail (ADR 0013).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_TRANSACTIONAL=orders@amazinggoats.store
EMAIL_FROM_MARKETING=news@amazinggoats.store
EMAIL_REPLY_TO=hello@amazinggoats.store
# Salt for the newsletter's IP hash; the raw IP is never stored (POPIA minimisation).
NEWSLETTER_IP_SALT=
SMTP_URL=smtp://localhost:1025
STORE_URL=https://amazinggoats.store
CORPORATE_URL=https://amazinggoats.besbpo.co.za
ORDERS_EMAIL=orders@amazinggoats.store
# Social follow links in the storefront footer (T-075). Each is optional: an
# unset handle renders no link, because a link to instagram.com with no account
# is a dead end. A WhatsApp value is a number, with or without a country code.
NEXT_PUBLIC_SOCIAL_WHATSAPP=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
