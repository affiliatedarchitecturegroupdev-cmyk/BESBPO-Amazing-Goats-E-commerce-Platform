# Copy to .env. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://ag:ag@localhost:5432/ag
REDIS_URL=redis://localhost:6379
# Store driver: 'memory' (default, no database) or 'sql' (uses DATABASE_URL).
STORE_DRIVER=memory
# Field-level encryption key for personal data (32 bytes: 64 hex or base64url).
# Required by the SQL stores that hold an encrypted field, such as the MFA secret.
FIELD_ENCRYPTION_KEY=
JWT_ISSUER=http://localhost:8080/realms/ag
JWT_AUDIENCE=ag-platform
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
TRADESAFE_CLIENT_ID=
TRADESAFE_CLIENT_SECRET=
TRADESAFE_WEBHOOK_SECRET=
LULAPAY_API_KEY=
LULAPAY_WEBHOOK_SECRET=
# LulaPay longer terms are a pilot; set to true to register the adapter.
LULAPAY_ENABLED=false
WHATSAPP_TOKEN=
SMTP_URL=smtp://localhost:1025
STORE_URL=https://amazinggoats.store
CORPORATE_URL=https://amazinggoats.besbpo.co.za
ORDERS_EMAIL=orders@amazinggoats.store
