{
  "$schema": "https://api.northflank.com/v1/schemas/template",
  "apiVersion": "v1.2",
  "name": "amazing-goats",
  "description": "Amazing Goats (Ezimbuzini) core platform in Johannesburg. Launch topology from docs/01-architecture.md: gateway, commerce, payments, logistics, notifications and the storefront. Postgres and Redis run as Northflank addons in the same project.",
  "arguments": {
    "JWT_ISSUER": "",
    "JWT_AUDIENCE": "ag-platform",
    "PEACH_ENTITY_ID": "",
    "PEACH_ACCESS_TOKEN": "",
    "PAYFAST_MERCHANT_ID": "",
    "PAYFAST_MERCHANT_KEY": "",
    "PAYFAST_PASSPHRASE": "",
    "STITCH_CLIENT_ID": "",
    "STITCH_CLIENT_SECRET": "",
    "STITCH_WEBHOOK_SECRET": "",
    "TRADESAFE_CLIENT_ID": "",
    "TRADESAFE_CLIENT_SECRET": "",
    "TRADESAFE_WEBHOOK_SECRET": "",
    "LULAPAY_API_KEY": "",
    "LULAPAY_WEBHOOK_SECRET": "",
    "LULAPAY_ENABLED": "false",
    "WHATSAPP_TOKEN": "",
    "SMTP_URL": "",
    "ALERT_WEBHOOK_URL": "",
    "ALERT_WEBHOOK_SECRET": "",
    "LOG_DRAIN_URL": "",
    "LOG_DRAIN_SECRET": "",
    "STORE_URL": "https://amazinggoats.store",
    "CORPORATE_URL": "https://amazinggoats.besbpo.co.za",
    "ORDERS_EMAIL": "orders@amazinggoats.store",
    "FIELD_ENCRYPTION_KEY": "",
    "ADMIN_IP_ALLOWLIST": ""
  },
  "options": {
    "autorun": false,
    "concurrencyPolicy": "allow"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "amazing-goats",
            "region": "africa-south",
            "description": "Amazing Goats (Ezimbuzini) production core.",
            "color": "#2f6f4f"
          }
        },
        {
          "kind": "Workflow",
          "ref": "core",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "postgres",
                "spec": {
                  "name": "ag-postgres",
                  "description": "One Postgres, one schema per bounded context. Money is integer cents (ZAR).",
                  "type": "postgresql",
                  "version": "16",
                  "tlsEnabled": true,
                  "externalAccessEnabled": false,
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storage": 8192,
                    "replicas": 1
                  }
                }
              },
              {
                "kind": "Addon",
                "ref": "redis",
                "spec": {
                  "name": "ag-redis",
                  "description": "Queues, cache and ad pacing.",
                  "type": "redis",
                  "version": "7",
                  "tlsEnabled": true,
                  "externalAccessEnabled": false,
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storage": 4096,
                    "replicas": 1
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "app-secrets",
                "spec": {
                  "name": "ag-app-secrets",
                  "description": "Runtime secrets inherited by the core services. Addon connection strings are linked below; application secrets come from the template arguments.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "addonDependencies": [
                    {
                      "addonId": "${refs.postgres.id}",
                      "keys": [{ "keyName": "POSTGRES_URI", "aliases": ["DATABASE_URL"] }]
                    },
                    {
                      "addonId": "${refs.redis.id}",
                      "keys": [{ "keyName": "REDIS_MASTER_URL", "aliases": ["REDIS_URL"] }]
                    }
                  ],
                  "secrets": {
                    "variables": {
                      "NODE_ENV": "production",
                      "JWT_ISSUER": "${args.JWT_ISSUER}",
                      "JWT_AUDIENCE": "${args.JWT_AUDIENCE}",
                      "PEACH_ENTITY_ID": "${args.PEACH_ENTITY_ID}",
                      "PEACH_ACCESS_TOKEN": "${args.PEACH_ACCESS_TOKEN}",
                      "PAYFAST_MERCHANT_ID": "${args.PAYFAST_MERCHANT_ID}",
                      "PAYFAST_MERCHANT_KEY": "${args.PAYFAST_MERCHANT_KEY}",
                      "PAYFAST_PASSPHRASE": "${args.PAYFAST_PASSPHRASE}",
                      "STITCH_CLIENT_ID": "${args.STITCH_CLIENT_ID}",
                      "STITCH_CLIENT_SECRET": "${args.STITCH_CLIENT_SECRET}",
                      "STITCH_WEBHOOK_SECRET": "${args.STITCH_WEBHOOK_SECRET}",
                      "TRADESAFE_CLIENT_ID": "${args.TRADESAFE_CLIENT_ID}",
                      "TRADESAFE_CLIENT_SECRET": "${args.TRADESAFE_CLIENT_SECRET}",
                      "TRADESAFE_WEBHOOK_SECRET": "${args.TRADESAFE_WEBHOOK_SECRET}",
                      "LULAPAY_API_KEY": "${args.LULAPAY_API_KEY}",
                      "LULAPAY_WEBHOOK_SECRET": "${args.LULAPAY_WEBHOOK_SECRET}",
                      "LULAPAY_ENABLED": "${args.LULAPAY_ENABLED}",
                      "WHATSAPP_TOKEN": "${args.WHATSAPP_TOKEN}",
                      "SMTP_URL": "${args.SMTP_URL}",
                      "ALERT_WEBHOOK_URL": "${args.ALERT_WEBHOOK_URL}",
                      "ALERT_WEBHOOK_SECRET": "${args.ALERT_WEBHOOK_SECRET}",
                      "STORE_URL": "${args.STORE_URL}",
                      "CORPORATE_URL": "${args.CORPORATE_URL}",
                      "ORDERS_EMAIL": "${args.ORDERS_EMAIL}",
                      "FIELD_ENCRYPTION_KEY": "${args.FIELD_ENCRYPTION_KEY}",
                      "ADMIN_IP_ALLOWLIST": "${args.ADMIN_IP_ALLOWLIST}"
                    },
                    "files": {}
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "kind": "CombinedService",
                "ref": "gateway",
                "spec": {
                  "name": "gateway",
                  "description": "NestJS: auth, RBAC, rate limits, BFF.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/services/gateway/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": true, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "commerce",
                "spec": {
                  "name": "commerce",
                  "description": "Catalogue, pricing, orders and cycles.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/services/commerce/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 3001,
                      "public": false,
                      "vpcAccessible": true,
                      "protocol": "HTTP"
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3001,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "payments",
                "spec": {
                  "name": "payments",
                  "description": "Provider interface and Peach, PayFast, Stitch adapters.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/services/payments/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 3005,
                      "public": false,
                      "vpcAccessible": true,
                      "protocol": "HTTP"
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3005,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "logistics",
                "spec": {
                  "name": "logistics",
                  "description": "Zones, slots and routes.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/services/logistics/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 3004,
                      "public": false,
                      "vpcAccessible": true,
                      "protocol": "HTTP"
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3004,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "notifications",
                "spec": {
                  "name": "notifications",
                  "description": "Email and WhatsApp templates.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/services/notifications/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 3006,
                      "public": false,
                      "vpcAccessible": true,
                      "protocol": "HTTP"
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3006,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 30,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "storefront",
                "spec": {
                  "name": "storefront",
                  "description": "Next.js public store. The remaining front ends are added the same way.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/apps/storefront/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": true, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "trade-portal",
                "spec": {
                  "name": "trade-portal",
                  "description": "Next.js trade portal: wholesale ordering, standing orders, statements and credit for trade customers.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/apps/trade-portal/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": true, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "admin",
                "spec": {
                  "name": "admin",
                  "description": "Next.js staff admin: catalogue, orders, pricing, credit, recalls, roles and audit. Private route, staff IP allow-list only.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/apps/admin/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": false, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "driver-pwa",
                "spec": {
                  "name": "driver-pwa",
                  "description": "Next.js installable driver PWA: day pack, proof of delivery and an encrypted offline queue. Public over HTTPS.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/apps/driver-pwa/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": true, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "advertiser-portal",
                "spec": {
                  "name": "advertiser-portal",
                  "description": "Next.js advertiser portal: campaigns, creatives and wallet.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/apps/advertiser-portal/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": true, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "partner-portal",
                "spec": {
                  "name": "partner-portal",
                  "description": "Next.js partner portal: orders, documents and actions for supply partners.",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-200-8"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/affiliatedarchitecturegroupdev-cmyk/BESBPO-Amazing-Goats-E-commerce-Platform",
                    "projectType": "github",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerFilePath": "/apps/partner-portal/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "*.md", "tasks/**"]
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 3000, "public": true, "protocol": "HTTP" }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/health",
                      "port": 3000,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
